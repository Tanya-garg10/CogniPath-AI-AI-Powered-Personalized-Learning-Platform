# GROQ_API_KEY: Required for Groq AI API calls (Llama 3.3 70B & Vision models).
# AI Studio automatically injects or accepts this from user environment/secrets.
GROQ_API_KEY="MY_GROQ_API_KEY"

# GEMINI_API_KEY: Fallback for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

